# Supabase — copy this file to .env.local and fill in your values.
# Find these in your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Use your anon key or sb_publishable_* key (never use sb_secret_* in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: set this if your Google OAuth redirect domain differs from window.location.origin
VITE_AUTH_REDIRECT_URL=https://your-domain.com/auth/callback
